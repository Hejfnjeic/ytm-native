# Maintainer: Hejfnjeic <359989157+Hejfnjeic@users.noreply.github.com>
# Builds ytm-native from a release's source tarball. For a package of the current checkout,
# run scripts/build-arch.sh instead (same PKGBUILD, local sources).
pkgname=ytm-native
pkgver=0.1.0
pkgrel=1
pkgdesc="Native desktop YouTube Music player (unofficial): radio, account sync, synced lyrics"
arch=('x86_64')
url="https://github.com/Hejfnjeic/ytm-native"
license=('GPL-3.0-only')
depends=('alsa-lib' 'dbus' 'fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'gtk3' 'libxkbcommon' 'openssl' 'wayland' 'webkit2gtk-4.1')
makedepends=('cargo')
optdepends=(
    'kwallet: keeps the key of the stored login (or another Secret Service provider)'
    'xdg-desktop-portal: file picker for importing the login'
)
# makepkg's LTO turns the bundled C (QuickJS) into bitcode Rust's linker can't read.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
    # Keep the builder's home directory out of the binary (source paths of panic messages).
    export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$HOME=/build"
    export CFLAGS="${CFLAGS:-} -ffile-prefix-map=$HOME=/build"
    cargo build --frozen --release -p ytm-native
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
    cargo test --frozen --release -p ytm-native
}

package() {
    cd "$pkgname-$pkgver"
    # The program with pacman.txt beside it: the app then knows pacman owns it, and only
    # tells when a new version is out (update.rs).
    install -Dm755 "${CARGO_TARGET_DIR:-target}/release/ytm-native" "$pkgdir/usr/lib/ytm-native/ytm-native"
    echo "Installed by pacman: updates come as a new package." > "$pkgdir/usr/lib/ytm-native/pacman.txt"
    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/lib/ytm-native/ytm-native "$pkgdir/usr/bin/ytm-native"
    install -Dm644 packaging/ytm-native.desktop "$pkgdir/usr/share/applications/ytm-native.desktop"
    install -Dm644 app/assets/icon/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ytm-native.svg"
    for n in 16 22 24; do
        install -Dm644 app/assets/icon/icon-small.svg "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/ytm-native.svg"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
