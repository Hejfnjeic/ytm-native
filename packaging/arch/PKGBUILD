# Maintainer: Hejfnjeic <359989157+Hejfnjeic@users.noreply.github.com>
# Builds ytm-native from a release's source tarball. For a package of the current checkout,
# run scripts/build-arch.sh instead (same PKGBUILD, local sources).
pkgname=ytm-native
pkgver=0.1.0
pkgrel=1
pkgdesc="Native desktop YouTube Music player (unofficial): radio, account sync, synced lyrics"
arch=('x86_64')
url="https://github.com/Hejfnjeic/ytm-native"
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'libxkbcommon' 'opus' 'wayland')
makedepends=('cargo')
optdepends=(
    'kwallet: keeps the key of the stored login (or another Secret Service provider)'
    'xdg-desktop-portal: file picker for importing the login'
)
# makepkg's LTO turns the bundled C (QuickJS) into bitcode Rust's linker can't read.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
    # pacman owns the installed files: the app only tells about new versions, it doesn't
    # replace itself.
    export YTM_PACKAGED=pacman
    cargo build --frozen --release -p ytm-native
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
    export YTM_PACKAGED=pacman
    cargo test --frozen --release -p ytm-native
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "${CARGO_TARGET_DIR:-target}/release/ytm-native" "$pkgdir/usr/bin/ytm-native"
    install -Dm644 packaging/ytm-native.desktop "$pkgdir/usr/share/applications/ytm-native.desktop"
    install -Dm644 app/assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ytm-native.svg"
    for n in 16 22 24; do
        install -Dm644 app/assets/icon-small.svg "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/ytm-native.svg"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
